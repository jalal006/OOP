@page
@model IndexModel
@{
    ViewData["Title"] = "AI Demo";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="container mt-4">
    <h1>AI Demo</h1>

    <form method="post" class="mt-4">
        <div class="mb-3">
            <label for="prompt" class="form-label">Describe the image</label>
            <input id="prompt"
                   name="Prompt"
                   class="form-control"
                   placeholder="Example: a city skyline at sunset"
                   value="@Model.Prompt" />
        </div>

        <button type="submit" asp-page-handler="GenerateImage" class="btn btn-primary">
            Generate image
        </button>

        <div class="mt-4">
            <label for="textPrompt" class="form-label">Ask for text</label>
            <textarea id="textPrompt"
                      name="TextPrompt"
                      class="form-control"
                      rows="4"
                      placeholder="Example: Write a short story">@Model.TextPrompt</textarea>
        </div>

        <div class="mt-3">
            <button type="submit" asp-page-handler="GenerateText" class="btn btn-success">
                Generate text
            </button>
        </div>
    </form>

    <div class="mt-4">
        <img src="@Model.GeneratedImageUrl"
             alt="Generated image"
             class="img-fluid border rounded"
             style="max-height: 420px;" />
    </div>

    <div class="mt-3">
        <label for="textAnswer" class="form-label">Answer</label>
        <textarea id="textAnswer"
                  class="form-control"
                  rows="5"
                  readonly>@Model.TextAnswer</textarea>
    </div>
</body>
</html>
